# Copy to .env and fill in values. Never commit .env.

# Required: bcrypt hash of the login password. Generate with:
#   rails runner "puts BCrypt::Password.create('your-password')"
# APP_PASSWORD=

# Optional: secret key for signing cookies/sessions. Generate with:
#   rails secret
# If unset, development/test generate their own key, and production (Docker)
# generates one on first boot and stores it in storage/.secret_key_base.
# SECRET_KEY_BASE=

# Optional: set to production when running via Docker
# RAILS_ENV=production

# BGG XML API bearer token (required for Fetch from BGG feature)
# BGG_API_TOKEN=
